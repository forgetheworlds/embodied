-        if (received < 0) {
-            if (errno != EAGAIN && errno != EWOULDBLOCK && errno != 0) {
-                fprintf(stderr, "error recv on socket in: %s \n",
-                        strerror(errno));
-            }
-        } else {
-            // fprintf(stderr, "received from control socket: %s\n", buf);
-        }
-    } while (received > 0);
-
-}
