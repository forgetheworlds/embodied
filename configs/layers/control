#!/usr/bin/env bash
# Control-layer live sim verification (Webots + SITL). Not pytest.
#
# Convention: configs/layers/<layer> is the one sim script that proves that
# layer. Pair with docs/<layer>.md and tests/test_<layer>.py.
#
# Exit 0 only when receipt gate_status is pass.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"

CONFIG="${CONFIG:-configs/layers/control.yaml}"
OUTPUT="${OUTPUT:-work/runs/layers/control}"

if [[ ! -x .venv/bin/python ]]; then
  echo "control: missing .venv; run scripts/bootstrap.sh first" >&2
  exit 2
fi

# shellcheck disable=SC1091
source .venv/bin/activate

export DISPLAY="${DISPLAY:-:1}"
export LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-1}"

rm -rf "$OUTPUT"
mkdir -p "$OUTPUT"

# Native Webots Supervisor movie (optional). Delayed past PreArm by default
# (EMBODIED_WEBOTS_MOVIE_DELAY_S=90) so encoding does not starve gyro bring-up.
# Example: EMBODIED_WEBOTS_MOVIE="$OUTPUT/control-doorway.mp4" ./configs/layers/control
# No CPU affinity / EMBODIED_SIM_CPUS — that previously destabilized the controller.
if [[ -n "${EMBODIED_WEBOTS_MOVIE:-}" ]]; then
  # Absolute path: Webots controller cwd is not the repo root.
  if [[ "${EMBODIED_WEBOTS_MOVIE}" != /* ]]; then
    EMBODIED_WEBOTS_MOVIE="$ROOT/${EMBODIED_WEBOTS_MOVIE}"
  fi
  export EMBODIED_WEBOTS_MOVIE
  export EMBODIED_WEBOTS_MOVIE_DELAY_S="${EMBODIED_WEBOTS_MOVIE_DELAY_S:-90}"
  mkdir -p "$(dirname "$EMBODIED_WEBOTS_MOVIE")"
fi

python -u -m embodied motion-proof --config "$CONFIG" --output "$OUTPUT"
status=$?
if [[ "$status" -ne 0 ]]; then
  exit "$status"
fi

RECEIPT="$OUTPUT/receipt.json"
if [[ ! -f "$RECEIPT" ]]; then
  echo "control: missing receipt at $RECEIPT" >&2
  exit 1
fi

python - "$RECEIPT" <<'PY'
import json
import sys
from pathlib import Path

receipt = json.loads(Path(sys.argv[1]).read_text())
gate = receipt.get("gate_status")
reasons = receipt.get("reasons") or []
print(f"control: status={receipt.get('status')} gate={gate}")
for reason in reasons:
    print(f"  reason: {reason}")
if gate != "pass":
    raise SystemExit(1)
PY
