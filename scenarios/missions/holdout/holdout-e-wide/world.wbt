# --- Target: red can (cylinder) on a 1.4 m shelf against R2's east wall -------------
Solid {
  name "target_shelf"
  translation 13.5 9.5 0.7
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.45 0.4 0.35 roughness 0.8 }
      geometry Box { size 0.6 0.6 1.4 }
    }
  ]
  boundingObject Box { size 0.6 0.6 1.4 }
}
Solid {
