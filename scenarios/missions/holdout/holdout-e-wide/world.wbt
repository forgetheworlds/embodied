#VRML_SIM R2025a utf8
# holdout-e-wide — held-out group: an 8 x 8 room and a 5 x 7 room at 3.2 m height, an
# 0.80 m doorway offset one third from the north end of the shared wall, one turn.
# Mission: search + inspect + return (red can on a 1.4 m shelf in R2, occluded from the
# spawn by the offset door edge). Held-out families here: wide/tall geometry, narrow
# offset doorway, RedBricks / CementTiles textures, dim lighting, cylinder target class.
#
# Provenance: structure, vehicle reference, controller block and determinism pins are
# inherited from scenarios/compat/worlds/compat_stereo.wbt (branch scenarios/indoor,
# 46af9ce). Walls, floor, lights, obstacles and the target are plain nodes; the only
# protos referenced are the compat Iris and the vendored Apache-2.0 appearances recorded
# in scenarios/missions/common/PROVENANCE.md. No stock Cyberbotics object proto, no
# remote EXTERNPROTO, nothing fetched at load time.
#
# Axis values for this layout: scenarios/missions/holdout/holdout-e-wide/layout.yaml
# EMBODIED_WORLD_ZERO world origin at floor level, x north, y west, z up (ENU).
EXTERNPROTO "../../../compat/protos/Iris.proto"
EXTERNPROTO "../../common/appearances/protos/RedBricks.proto"
EXTERNPROTO "../../common/appearances/protos/CementTiles.proto"

WorldInfo {
  title "indoor holdout-e-wide: two wide rooms, offset 0.8 m doorway"
  basicTimeStep 2
  FPS 20
  optimalThreadCount 1
  randomSeed 0
}
Viewpoint {
  orientation 0.35 -0.85 -0.40 2.20
  position -4.0 -7.0 9.0
}
Background {
  skyColor [0.35 0.35 0.5]
}
# Held-out lighting family: dim DirectionalLight plus two PointLights.
DirectionalLight {
  direction 0.2 -0.4 -1
  intensity 0.4
}
PointLight {
  translation 4 -2 2.6
  color 1 0.9 0.75
  intensity 0.8
}
PointLight {
  translation 12 7 2.6
  color 1 0.9 0.75
  intensity 0.8
}
# Floor: one plane under room, corridor and R2, CementTiles as declared.
Solid {
  name "floor"
  translation 7.05 3.25 -0.02
  children [
    Shape {
      appearance CementTiles {}
      geometry Plane {
        size 14.3 14.7
      }
    }
  ]
  boundingObject Plane {
    size 14.3 14.7
  }
}
# --- Walls (thickness 0.1, interior height 3.2, doorway gap top at 2.0) --------------
# R1 east wall with the 0.80 m doorway, its south edge 0.40 m inside the wall's
# one-third point measured from the north end (gap centre y = 1.33, offset 2.67 m).
Solid {
  name "w_r1_east_a"
  translation 8 -1.535 1.6
  children [
    Shape {
      appearance RedBricks {}
      geometry Box { size 0.1 4.93 3.2 }
    }
  ]
  boundingObject Box { size 0.1 4.93 3.2 }
}
Solid {
