}
Iris {
  translation 2 0 0.09
  controller "compat_vehicle_controller"
  controllerArgs [
    "--sitl-address"
    "127.0.0.1"
    "--sitl-port"
    "9002"
    "--controller-port"
    "9010"
    "--motors"
    "m1_motor, m2_motor, m3_motor, m4_motor"
    "--camera-left"
    "camera left"
    "--camera-right"
    "camera right"
    "--camera-period-ms"
    "100"
    "--accelerometer"
    "accelerometer"
    "--gyro"
    "gyro"
    "--inertial-unit"
    "inertial unit"
    "--gps"
    "gps"
    "--imu-period-ms"
    "2"
  ]
  customData "{\"group\": \"holdout\", \"layout\": \"holdout-e-wide\", \"mission\": \"search_inspect_return\", \"world_zero\": \"floor level, ENU\"}"
}
