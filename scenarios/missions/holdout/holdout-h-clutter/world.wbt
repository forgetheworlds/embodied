#VRML_SIM R2025a utf8
# holdout-h-clutter — held-out group: a 7 x 5 room and a 6 x 4 room joined by a 1.4 m
# link corridor with one turn, through a 0.80 m corner-adjacent doorway.
# Mission: inspect a region and search under clutter (red can inside the dense cluster in
# R2); the mid-mission semantic-change stress variant is declared in mission.yaml.
# Held-out families here: narrow corner doorway, 10 obstacles clustered in the region,
# Marble / CementTiles textures, dim lighting with a shadowed corner, cylinder target.
#
# Provenance: structure, vehicle reference, controller block and determinism pins are
# inherited from scenarios/compat/worlds/compat_stereo.wbt (branch scenarios/indoor,
# 46af9ce). Walls, floor, lights, obstacles and the target are plain nodes; the only
# protos referenced are the compat Iris and the vendored Apache-2.0 appearances recorded
# in scenarios/missions/common/PROVENANCE.md. No stock Cyberbotics object proto, no
# remote EXTERNPROTO, nothing fetched at load time.
#
# Axis values for this layout: scenarios/missions/holdout/holdout-h-clutter/layout.yaml
# EMBODIED_WORLD_ZERO world origin at floor level, x north, y west, z up (ENU).
EXTERNPROTO "../../../compat/protos/Iris.proto"
EXTERNPROTO "../../common/appearances/protos/Marble.proto"
EXTERNPROTO "../../common/appearances/protos/CementTiles.proto"

WorldInfo {
  title "indoor holdout-h-clutter: two rooms, a corner doorway, a dense cluster"
  basicTimeStep 2
  FPS 20
  optimalThreadCount 1
  randomSeed 0
}
Viewpoint {
  orientation 0.35 -0.85 -0.40 2.00
  position -4.0 -4.0 8.0
}
Background {
  skyColor [0.35 0.35 0.5]
}
# Held-out lighting family: dim DirectionalLight plus three PointLights; the last one is
# deliberately weak, leaving R2's north-east corner shadowed.
DirectionalLight {
  direction 0.2 -0.4 -1
  intensity 0.45
}
PointLight {
  translation 3 2.5 2.4
  color 1 0.9 0.75
  intensity 0.8
}
PointLight {
  translation 10 4.5 2.4
  color 1 0.9 0.75
  intensity 0.8
}
PointLight {
  translation 13 6.5 2.4
  color 1 0.9 0.75
  intensity 0.4
}
# Floor: one plane under both rooms and the link, CementTiles as declared.
Solid {
  name "floor"
  translation 6.8 3.5 -0.02
  children [
    Shape {
      appearance CementTiles {}
      geometry Plane {
        size 13.8 7.2
      }
    }
  ]
  boundingObject Plane {
    size 13.8 7.2
  }
}
