#VRML_SIM R2025a utf8
# holdout-f-z — held-out group: two rooms joined by a Z-shaped corridor (two 90-degree
# turns, a topology that occurs zero times in dev) with a 1.20 m doorway placed
# corner-adjacent, 0.40 m from the perpendicular wall.
# Mission: search + inspect + return (red bottle on the R2 floor). Held-out families
# here: 2.2 m height, narrow 1.4 m Z-corridor, wide offset doorway, Marble /
# PorcelainChevronTiles textures, dim lighting, cylinder target class.
#
# Provenance: structure, vehicle reference, controller block and determinism pins are
# inherited from scenarios/compat/worlds/compat_stereo.wbt (branch scenarios/indoor,
# 46af9ce). Walls, floor, lights, obstacles and the target are plain nodes; the only
# protos referenced are the compat Iris and the vendored Apache-2.0 appearances recorded
# in scenarios/missions/common/PROVENANCE.md. No stock Cyberbotics object proto, no
# remote EXTERNPROTO, nothing fetched at load time.
#
# Axis values for this layout: scenarios/missions/holdout/holdout-f-z/layout.yaml
# EMBODIED_WORLD_ZERO world origin at floor level, x north, y west, z up (ENU).
EXTERNPROTO "../../../compat/protos/Iris.proto"
EXTERNPROTO "../../common/appearances/protos/Marble.proto"
EXTERNPROTO "../../common/appearances/protos/PorcelainChevronTiles.proto"

WorldInfo {
  title "indoor holdout-f-z: two rooms with a two-turn Z corridor"
  basicTimeStep 2
  FPS 20
  optimalThreadCount 1
  randomSeed 0
}
Viewpoint {
  orientation 0.35 -0.85 -0.40 1.80
  position -4.0 -4.0 7.0
}
Background {
  skyColor [0.35 0.35 0.5]
}
# Held-out lighting family: dim DirectionalLight plus three PointLights, one per leg.
DirectionalLight {
  direction 0.2 -0.4 -1
  intensity 0.5
}
PointLight {
  translation 3 3 1.9
  color 1 0.9 0.75
  intensity 0.7
}
PointLight {
  translation 7.3 2.9 1.95
  color 1 0.9 0.75
  intensity 0.7
}
PointLight {
  translation 12 5 1.9
  color 1 0.9 0.75
  intensity 0.7
}
# Floor: one plane under both rooms and the Z corridor, PorcelainChevronTiles as declared.
Solid {
  name "floor"
  translation 7.25 3.8 -0.02
  children [
    Shape {
      appearance PorcelainChevronTiles {}
      geometry Plane {
        size 14.7 7.8
      }
    }
  ]
  boundingObject Plane {
    size 14.7 7.8
  }
}
