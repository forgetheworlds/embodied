#VRML_SIM R2025a utf8
# holdout-g-long — held-out group: a 4 x 14 room with a 1.6 m T-spur (branch off the
# long wall through an 1.20 m mouth offset one third along it, then one turn inside the
# spur). No target object exists in this world: the mission is an honest absent-target
# search over the declared region room u spur, plus traversal.
# Held-out families here: 14 m length, T-junction topology, RedBricks /
# PorcelainChevronTiles textures, dim lighting, absent cylinder-class target.
#
# Provenance: structure, vehicle reference, controller block and determinism pins are
# inherited from scenarios/compat/worlds/compat_stereo.wbt (branch scenarios/indoor,
# 46af9ce). Walls, floor, lights and obstacles are plain nodes; the only protos
# referenced are the compat Iris and the vendored Apache-2.0 appearances recorded in
# scenarios/missions/common/PROVENANCE.md. No stock Cyberbotics object proto, no remote
# EXTERNPROTO, nothing fetched at load time.
#
# Axis values for this layout: scenarios/missions/holdout/holdout-g-long/layout.yaml
# EMBODIED_WORLD_ZERO world origin at floor level, x north, y west, z up (ENU).
EXTERNPROTO "../../../compat/protos/Iris.proto"
EXTERNPROTO "../../common/appearances/protos/RedBricks.proto"
EXTERNPROTO "../../common/appearances/protos/PorcelainChevronTiles.proto"

WorldInfo {
  title "indoor holdout-g-long: a fourteen-metre room with a T-spur"
  basicTimeStep 2
  FPS 20
  optimalThreadCount 1
  randomSeed 0
}
Viewpoint {
  orientation 0.35 -0.85 -0.40 2.40
  position -5.0 -3.0 11.0
}
Background {
  skyColor [0.35 0.35 0.5]
}
# Held-out lighting family: dim DirectionalLight plus two PointLights.
DirectionalLight {
  direction 0.2 -0.4 -1
  intensity 0.6
}
PointLight {
  translation 2 5 2.2
  color 1 0.9 0.75
  intensity 0.7
}
PointLight {
  translation 2 11 2.2
  color 1 0.9 0.75
  intensity 0.7
}
# Floor: one plane under room and spur, PorcelainChevronTiles as declared.
Solid {
  name "floor"
  translation 3.25 7 -0.02
  children [
    Shape {
      appearance PorcelainChevronTiles {}
      geometry Plane {
        size 6.7 14.2
      }
    }
  ]
  boundingObject Plane {
    size 6.7 14.2
  }
}
