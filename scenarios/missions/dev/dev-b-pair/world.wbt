#VRML_SIM R2025a utf8
# dev-b-pair — development group: two rooms joined by a 1.6 m link corridor with one
# 90-degree turn and one 1.10 m centred doorway.
# Mission: search + inspect + return (red sphere on the R2 floor behind the table-height
# obstacle; a red block in R1 is a registered ambiguous candidate of the wrong class).
#
# Provenance: structure, vehicle reference, controller block and determinism pins are
# inherited from scenarios/compat/worlds/compat_stereo.wbt (branch scenarios/indoor,
# 46af9ce). Walls, floor, lights, obstacles and targets are plain nodes; the only protos
# referenced are the compat Iris and the vendored Apache-2.0 appearances recorded in
# scenarios/missions/common/PROVENANCE.md. No stock Cyberbotics object proto, no remote
# EXTERNPROTO, nothing fetched at load time.
#
# Axis values for this layout: scenarios/missions/dev/dev-b-pair/layout.yaml
# EMBODIED_WORLD_ZERO world origin at floor level, x north, y west, z up (ENU).
EXTERNPROTO "../../../compat/protos/Iris.proto"
EXTERNPROTO "../../common/appearances/protos/Roughcast.proto"
EXTERNPROTO "../../common/appearances/protos/DarkParquetry.proto"

WorldInfo {
  title "indoor dev-b-pair: two rooms with a turned link corridor"
  basicTimeStep 2
  FPS 20
  optimalThreadCount 1
  randomSeed 0
}
Viewpoint {
  orientation 0.35 -0.85 -0.40 1.60
  position -3.5 -5.5 6.0
}
Background {
  skyColor [0.6 0.6 0.85]
}
# Development lighting family: DirectionalLight plus one warm PointLight at the R1 centre.
DirectionalLight {
  direction 0.2 -0.4 -1
  intensity 1.0
}
PointLight {
  translation 2.5 0 2.2
  color 1 0.9 0.75
  intensity 0.7
}
# Floor: one plane under both rooms and the link corridor, DarkParquetry as declared.
Solid {
  name "floor"
  translation 4.95 2.75 -0.02
  children [
    Shape {
      appearance DarkParquetry {}
      geometry Plane {
        size 10.1 10.7
      }
    }
  ]
  boundingObject Plane {
    size 10.1 10.7
  }
}
# --- Walls (thickness 0.1, interior height 2.5, doorway gap top at 2.0) --------------
Solid {
  name "w_r1_west"
  translation -0.05 0 1.25
  children [
    Shape {
      appearance Roughcast {}
      geometry Box { size 0.1 5 2.5 }
    }
  ]
  boundingObject Box { size 0.1 5 2.5 }
}
Solid {
  name "w_r1_north"
  translation 2.5 2.55 1.25
  children [
    Shape {
      appearance Roughcast {}
      geometry Box { size 5 0.1 2.5 }
    }
  ]
  boundingObject Box { size 5 0.1 2.5 }
}
Solid {
  name "w_r1_south"
  translation 2.5 -2.55 1.25
  children [
    Shape {
      appearance Roughcast {}
      geometry Box { size 5 0.1 2.5 }
    }
  ]
  boundingObject Box { size 5 0.1 2.5 }
}
# R1 east wall with the 1.10 m centred doorway into the link corridor.
Solid {
  name "w_r1_east_a"
  translation 5 -1.525 1.25
  children [
    Shape {
      appearance Roughcast {}
      geometry Box { size 0.1 1.95 2.5 }
    }
  ]
  boundingObject Box { size 0.1 1.95 2.5 }
}
Solid {
  name "w_r1_east_b"
  translation 5 1.525 1.25
  children [
    Shape {
      appearance Roughcast {}
      geometry Box { size 0.1 1.95 2.5 }
    }
  ]
  boundingObject Box { size 0.1 1.95 2.5 }
}
Solid {
  name "w_r1_east_lintel"
  translation 5 0 2.25
  children [
    Shape {
      appearance Roughcast {}
      geometry Box { size 0.1 1.1 0.5 }
    }
  ]
  boundingObject Box { size 0.1 1.1 0.5 }
}
# Link corridor: leg east out of R1, then one turn north into R2.
Solid {
  name "w_corr_south"
  translation 6.275 -0.85 1.25
  children [
    Shape {
      appearance Roughcast {}
      geometry Box { size 2.55 0.1 2.5 }
    }
  ]
  boundingObject Box { size 2.55 0.1 2.5 }
}
Solid {
  name "w_corr_north"
  translation 5.45 0.85 1.25
  children [
    Shape {
      appearance Roughcast {}
      geometry Box { size 0.9 0.1 2.5 }
    }
  ]
  boundingObject Box { size 0.9 0.1 2.5 }
}
Solid {
  name "w_corr_leg_b_west"
  translation 5.85 1.4 1.25
  children [
    Shape {
      appearance Roughcast {}
      geometry Box { size 0.1 1.2 2.5 }
    }
  ]
  boundingObject Box { size 0.1 1.2 2.5 }
}
Solid {
  name "w_corr_east"
  translation 7.55 0.6 1.25
  children [
    Shape {
      appearance Roughcast {}
      geometry Box { size 0.1 2.8 2.5 }
    }
  ]
  boundingObject Box { size 0.1 2.8 2.5 }
}
# R2 (the corridor mouth is the 1.6 m opening in its south wall).
Solid {
  name "w_r2_south"
  translation 8.7 1.95 1.25
  children [
    Shape {
      appearance Roughcast {}
      geometry Box { size 2.4 0.1 2.5 }
    }
  ]
  boundingObject Box { size 2.4 0.1 2.5 }
}
Solid {
  name "w_r2_west"
  translation 5.85 5 1.25
  children [
    Shape {
      appearance Roughcast {}
      geometry Box { size 0.1 6 2.5 }
    }
  ]
  boundingObject Box { size 0.1 6 2.5 }
}
Solid {
  name "w_r2_east"
  translation 9.95 5 1.25
  children [
    Shape {
      appearance Roughcast {}
      geometry Box { size 0.1 6 2.5 }
    }
  ]
  boundingObject Box { size 0.1 6 2.5 }
}
Solid {
  name "w_r2_north"
  translation 7.9 8.05 1.25
  children [
    Shape {
      appearance Roughcast {}
      geometry Box { size 4 0.1 2.5 }
    }
  ]
  boundingObject Box { size 4 0.1 2.5 }
}
# --- Obstacles: three floor boxes and one table-height box, >= 1.0 m off the route ---
Solid {
  name "obstacle_1"
  translation 2 1.8 0.3
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.5 0.52 0.55 roughness 0.9 }
      geometry Box { size 0.6 0.6 0.6 }
    }
  ]
  boundingObject Box { size 0.6 0.6 0.6 }
}
Solid {
  name "obstacle_2"
  translation 3.5 -1.8 0.3
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.5 0.52 0.55 roughness 0.9 }
      geometry Box { size 0.6 0.6 0.6 }
    }
  ]
  boundingObject Box { size 0.6 0.6 0.6 }
}
Solid {
  name "obstacle_3_table"
  translation 8 4 0.375
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.55 0.45 0.35 roughness 0.8 }
      geometry Box { size 1.2 0.6 0.75 }
    }
  ]
  boundingObject Box { size 1.2 0.6 0.75 }
}
Solid {
  name "obstacle_4"
  translation 7 3 0.3
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.5 0.52 0.55 roughness 0.9 }
      geometry Box { size 0.6 0.6 0.6 }
    }
  ]
  boundingObject Box { size 0.6 0.6 0.6 }
}
# --- Target: red sphere on the R2 floor, behind the table-height obstacle -----------
Solid {
  name "target_sphere"
  translation 8 5.4 0.25
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.85 0.05 0.05 metalness 0 roughness 0.5 }
      geometry Sphere { radius 0.25 }
    }
  ]
  boundingObject Sphere { radius 0.25 }
}
# Registered ambiguous candidate: a red block of the wrong target class, in R1.
Solid {
  name "distractor_block"
  translation 4 -1.3 0.15
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.85 0.05 0.05 metalness 0 roughness 0.6 }
      geometry Box { size 0.3 0.3 0.3 }
    }
  ]
  boundingObject Box { size 0.3 0.3 0.3 }
}
Iris {
  translation 2 0 0.09
  controller "compat_vehicle_controller"
  controllerArgs [
    "--sitl-address"
    "127.0.0.1"
    "--sitl-port"
    "9002"
    "--controller-port"
    "9010"
    "--motors"
    "m1_motor, m2_motor, m3_motor, m4_motor"
    "--camera-left"
    "camera left"
    "--camera-right"
    "camera right"
    "--camera-period-ms"
    "100"
    "--accelerometer"
    "accelerometer"
    "--gyro"
    "gyro"
    "--inertial-unit"
    "inertial unit"
    "--gps"
    "gps"
    "--imu-period-ms"
    "2"
  ]
  customData "{\"group\": \"dev\", \"layout\": \"dev-b-pair\", \"mission\": \"search_inspect_return\", \"world_zero\": \"floor level, ENU\"}"
}
