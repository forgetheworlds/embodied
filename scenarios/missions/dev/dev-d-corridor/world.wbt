#VRML_SIM R2025a utf8
# dev-d-corridor — development group: an 8.0 m corridor of 1.6 m width, one 90-degree
# turn, and a 3.0 x 3.0 end chamber behind a 1.10 m centred doorway.
# Mission: traverse to a point and inspect a region — there is no target object; the
# end-chamber wall carries a red inspection stripe as the region's witness.
#
# Provenance: structure, vehicle reference, controller block and determinism pins are
# inherited from scenarios/compat/worlds/compat_stereo.wbt (branch scenarios/indoor,
# 46af9ce). Walls, floor, lights and obstacles are plain nodes; the only protos
# referenced are the compat Iris and the vendored Apache-2.0 appearances recorded in
# scenarios/missions/common/PROVENANCE.md. No stock Cyberbotics object proto, no remote
# EXTERNPROTO, nothing fetched at load time.
#
# Axis values for this layout: scenarios/missions/dev/dev-d-corridor/layout.yaml
# EMBODIED_WORLD_ZERO world origin at floor level, x north, y west, z up (ENU).
EXTERNPROTO "../../../compat/protos/Iris.proto"
EXTERNPROTO "../../common/appearances/protos/Plaster.proto"
EXTERNPROTO "../../common/appearances/protos/Parquetry.proto"

WorldInfo {
  title "indoor dev-d-corridor: an eight-metre corridor and an end chamber"
  basicTimeStep 2
  FPS 20
  optimalThreadCount 1
  randomSeed 0
}
Viewpoint {
  orientation 0.35 -0.85 -0.40 1.40
  position -3.0 -4.0 5.0
}
Background {
  skyColor [0.6 0.6 0.85]
}
# Development lighting family: a single explicit DirectionalLight.
DirectionalLight {
  direction 0.2 -0.4 -1
  intensity 1.0
}
# Floor: one plane under corridor and chamber, Parquetry (mosaic) as declared.
Solid {
  name "floor"
  translation 4.7 2.3 -0.02
  children [
    Shape {
      appearance Parquetry {}
      geometry Plane {
        size 9.6 6.4
      }
    }
  ]
  boundingObject Plane {
    size 9.6 6.4
  }
}
# --- Walls (thickness 0.1, interior height 2.4, doorway gap top at 2.0) --------------
# Corridor: 8.0 m leg west-to-east, then one turn north.
Solid {
  name "w_corr_south"
  translation 4 -0.85 1.2
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 8 0.1 2.4 }
    }
  ]
  boundingObject Box { size 8 0.1 2.4 }
}
Solid {
  name "w_corr_north"
  translation 3.2 0.85 1.2
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 6.4 0.1 2.4 }
    }
  ]
  boundingObject Box { size 6.4 0.1 2.4 }
}
Solid {
  name "w_corr_east"
  translation 8.05 0.8 1.2
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 0.1 3.2 2.4 }
    }
  ]
  boundingObject Box { size 0.1 3.2 2.4 }
}
Solid {
  name "w_leg_b_west"
  translation 6.35 1.6 1.2
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 0.1 1.6 2.4 }
    }
  ]
  boundingObject Box { size 0.1 1.6 2.4 }
}
# Chamber south wall with the 1.10 m centred doorway on the corridor axis.
Solid {
  name "w_chamber_south_a"
  translation 6.525 2.35 1.2
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 0.25 0.1 2.4 }
    }
  ]
  boundingObject Box { size 0.25 0.1 2.4 }
}
Solid {
  name "w_chamber_south_b"
  translation 8.575 2.35 1.2
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 1.65 0.1 2.4 }
    }
  ]
  boundingObject Box { size 1.65 0.1 2.4 }
}
Solid {
  name "w_chamber_south_lintel"
  translation 7.2 2.35 2.2
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 1.1 0.1 0.4 }
    }
  ]
  boundingObject Box { size 1.1 0.1 0.4 }
}
Solid {
  name "w_chamber_west"
  translation 6.35 3.9 1.2
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 0.1 3 2.4 }
    }
  ]
  boundingObject Box { size 0.1 3 2.4 }
}
Solid {
  name "w_chamber_east"
  translation 9.45 3.9 1.2
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 0.1 3 2.4 }
    }
  ]
  boundingObject Box { size 0.1 3 2.4 }
}
Solid {
  name "w_chamber_north"
  translation 7.9 5.45 1.2
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 3 0.1 2.4 }
    }
  ]
  boundingObject Box { size 3 0.1 2.4 }
}
# --- Obstacles: three boxes flush against the corridor walls (route is the corridor) -
Solid {
  name "obstacle_1"
  translation 2 0.55 0.3
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.5 0.52 0.55 roughness 0.9 }
      geometry Box { size 0.6 0.6 0.6 }
    }
  ]
  boundingObject Box { size 0.6 0.6 0.6 }
}
Solid {
  name "obstacle_2"
  translation 4.5 -0.55 0.3
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.5 0.52 0.55 roughness 0.9 }
      geometry Box { size 0.6 0.6 0.6 }
    }
  ]
  boundingObject Box { size 0.6 0.6 0.6 }
}
Solid {
  name "obstacle_3"
  translation 6.9 0.55 0.3
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.5 0.52 0.55 roughness 0.9 }
      geometry Box { size 0.6 0.6 0.6 }
    }
  ]
  boundingObject Box { size 0.6 0.6 0.6 }
}
# --- Inspection region witness: a red stripe on the end chamber's far wall -----------
Solid {
  name "inspection_stripe"
  translation 7.9 5.37 1.2
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.85 0.05 0.05 metalness 0 roughness 0.6 }
      geometry Box { size 0.8 0.04 0.3 }
    }
  ]
  boundingObject Box { size 0.8 0.04 0.3 }
}
Iris {
  translation 0.8 0 0.09
  controller "compat_vehicle_controller"
  controllerArgs [
    "--sitl-address"
    "127.0.0.1"
    "--sitl-port"
    "9002"
    "--controller-port"
    "9010"
    "--motors"
    "m1_motor, m2_motor, m3_motor, m4_motor"
    "--camera-left"
    "camera left"
    "--camera-right"
    "camera right"
    "--camera-period-ms"
    "100"
    "--accelerometer"
    "accelerometer"
    "--gyro"
    "gyro"
    "--inertial-unit"
    "inertial unit"
    "--gps"
    "gps"
    "--imu-period-ms"
    "2"
  ]
  customData "{\"group\": \"dev\", \"layout\": \"dev-d-corridor\", \"mission\": \"traverse_inspect\", \"world_zero\": \"floor level, ENU\"}"
}
