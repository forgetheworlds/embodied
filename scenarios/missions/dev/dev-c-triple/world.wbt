#VRML_SIM R2025a utf8
# dev-c-triple — development group: three rooms, two centred doorways (1.00 m and
# 0.95 m), two link corridors with one 90-degree turn.
# Mission: search + inspect + return (red block on a 1.2 m shelf in R3; the absent-target
# variant omits the target node over the declared region R1 u R2 u R3).
#
# Provenance: structure, vehicle reference, controller block and determinism pins are
# inherited from scenarios/compat/worlds/compat_stereo.wbt (branch scenarios/indoor,
# 46af9ce). Walls, floor, lights, obstacles and the target are plain nodes; the only
# protos referenced are the compat Iris and the vendored Apache-2.0 appearances recorded
# in scenarios/missions/common/PROVENANCE.md. No stock Cyberbotics object proto, no
# remote EXTERNPROTO, nothing fetched at load time.
#
# Axis values for this layout: scenarios/missions/dev/dev-c-triple/layout.yaml
# EMBODIED_WORLD_ZERO world origin at floor level, x north, y west, z up (ENU).
EXTERNPROTO "../../../compat/protos/Iris.proto"
EXTERNPROTO "../../common/appearances/protos/PaintedWood.proto"
EXTERNPROTO "../../common/appearances/protos/ChequeredParquetry.proto"

WorldInfo {
  title "indoor dev-c-triple: three rooms, two doorways, one turn"
  basicTimeStep 2
  FPS 20
  optimalThreadCount 1
  randomSeed 0
}
Viewpoint {
  orientation 0.35 -0.85 -0.40 2.00
  position -4.0 -6.0 8.0
}
Background {
  skyColor [0.6 0.6 0.85]
}
# Development lighting family: DirectionalLight plus two warm PointLights (R1, R3).
DirectionalLight {
  direction 0.2 -0.4 -1
  intensity 1.2
}
PointLight {
  translation 2.5 0 2.1
  color 1 0.9 0.75
  intensity 0.6
}
PointLight {
  translation 14.1 -5.4 2.1
  color 1 0.9 0.75
  intensity 0.6
}
# Floor: one plane under all three rooms and both links, ChequeredParquetry as declared.
Solid {
  name "floor"
  translation 7.95 -3.2 -0.02
  children [
    Shape {
      appearance ChequeredParquetry {}
      geometry Plane {
        size 16.1 10.6
      }
    }
  ]
  boundingObject Plane {
    size 16.1 10.6
  }
}
