#VRML_SIM R2025a utf8
# first-indoor — the P05 evaluation scene: a vestibule spawn and two rooms;
# exactly one red block, in one of the rooms.
# Mission: search + inspect + return. The route, the doorway order and the
# target's location are deliberately declared nowhere outside this geometry:
# not in mission.yaml, not in customData, not in any comment beyond what the
# build record below needs to say what was built.
#
# Provenance: structure, vehicle reference, controller block and determinism
# pins are inherited from scenarios/missions/dev/dev-a-single/world.wbt
# (branch scenarios/indoor, 87a043c) via scenarios/compat/worlds/compat_stereo.wbt.
# Walls, floor, lights, obstacles, decoy and target are plain nodes; the only
# protos referenced are the compat Iris and the vendored Apache-2.0 appearances
# copied under assets/ (sha256 recorded in assets/PROVENANCE.md). No stock
# Cyberbotics object proto, no remote EXTERNPROTO, nothing fetched at load time.
#
# EMBODIED_WORLD_ZERO world origin at floor level, x north, y west, z up (ENU).
EXTERNPROTO "../compat/protos/Iris.proto"
EXTERNPROTO "assets/protos/Plaster.proto"
EXTERNPROTO "assets/protos/Parquetry.proto"

WorldInfo {
  title "indoor first-indoor: a vestibule and two rooms"
  basicTimeStep 2
  FPS 20
  optimalThreadCount 1
  randomSeed 0
}
Viewpoint {
  orientation 0.35 -0.85 -0.40 1.30
  position -4.5 -4.0 4.5
}
Background {
  skyColor [0.6 0.6 0.85]
}
# Development lighting family: one explicit DirectionalLight at compatibility
# intensity, as in the eight catalogue worlds.
DirectionalLight {
  direction 0.2 -0.4 -1
  intensity 1.2
}
# Floor: one plane under vestibule and both rooms, Parquetry (mosaic) as declared.
Solid {
  name "floor"
  translation 4 0 -0.02
  children [
    Shape {
      appearance Parquetry { type "mosaic" }
      geometry Plane {
        size 12.4 5.4
      }
    }
  ]
  boundingObject Plane {
    size 12.4 5.4
  }
}
# Ceiling: the rooms are enclosed. Without one, a climbing camera leaves the
# walls and sees the uniform Background sky, where a visual-inertial estimator
# loses every feature it is tracking (the P01-L failure recorded in the dev
# worlds' header). Thin box, like the walls, so it is visible from below.
Solid {
  name "ceiling"
  translation 4 0 2.55
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 12.4 5.4 0.1 }
    }
  ]
  boundingObject Box { size 12.4 5.4 0.1 }
}
# --- Walls (thickness 0.1, interior height 2.5, doorway gaps top at 2.0) -------------
# Vestibule: x in [-2, 0], y in [-1, 1].
Solid {
  name "w_vest_west"
  translation -2.05 0 1.25
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 0.1 2 2.5 }
    }
  ]
  boundingObject Box { size 0.1 2 2.5 }
}
Solid {
  name "w_vest_north"
  translation -1 1.05 1.25
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 2 0.1 2.5 }
    }
  ]
  boundingObject Box { size 2 0.1 2.5 }
}
Solid {
  name "w_vest_south"
  translation -1 -1.05 1.25
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 2 0.1 2.5 }
    }
  ]
  boundingObject Box { size 2 0.1 2.5 }
}
# Shared wall at x = 0 (vestibule to first room), 1.00 m centred doorway:
# two segments and a lintel.
Solid {
  name "w_shared_x0_a"
  translation 0 1.5 1.25
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 0.1 2 2.5 }
    }
  ]
  boundingObject Box { size 0.1 2 2.5 }
}
Solid {
  name "w_shared_x0_b"
  translation 0 -1.5 1.25
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 0.1 2 2.5 }
    }
  ]
  boundingObject Box { size 0.1 2 2.5 }
}
Solid {
  name "w_shared_x0_lintel"
  translation 0 0 2.25
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 0.1 1 0.5 }
    }
  ]
  boundingObject Box { size 0.1 1 0.5 }
}
# First room: x in [0, 5], y in [-2.5, 2.5].
Solid {
  name "w_r1_north"
  translation 2.5 2.55 1.25
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 5 0.1 2.5 }
    }
  ]
  boundingObject Box { size 5 0.1 2.5 }
}
Solid {
  name "w_r1_south"
  translation 2.5 -2.55 1.25
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 5 0.1 2.5 }
    }
  ]
  boundingObject Box { size 5 0.1 2.5 }
}
# Shared wall at x = 5 (first room to second room), 1.00 m doorway offset
# from the wall's midline: two segments and a lintel.
Solid {
  name "w_shared_x5_a"
  translation 5 -0.9 1.25
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 0.1 3.2 2.5 }
    }
  ]
  boundingObject Box { size 0.1 3.2 2.5 }
}
Solid {
  name "w_shared_x5_b"
  translation 5 2.1 1.25
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 0.1 0.8 2.5 }
    }
  ]
  boundingObject Box { size 0.1 0.8 2.5 }
}
Solid {
  name "w_shared_x5_lintel"
  translation 5 1.2 2.25
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 0.1 1 0.5 }
    }
  ]
  boundingObject Box { size 0.1 1 0.5 }
}
# Second room: x in [5, 10], y in [-2.5, 2.5].
Solid {
  name "w_r2_north"
  translation 7.5 2.55 1.25
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 5 0.1 2.5 }
    }
  ]
  boundingObject Box { size 5 0.1 2.5 }
}
Solid {
  name "w_r2_south"
  translation 7.5 -2.55 1.25
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 5 0.1 2.5 }
    }
  ]
  boundingObject Box { size 5 0.1 2.5 }
}
Solid {
  name "w_r2_east"
  translation 10.05 0 1.25
  children [
    Shape {
      appearance Plaster {}
      geometry Box { size 0.1 5 2.5 }
    }
  ]
  boundingObject Box { size 0.1 5 2.5 }
}
# --- Obstacles: floor boxes, 0.5 m, clear of the declared flight volume --------------
Solid {
  name "obstacle_1"
  translation 1.0 -1.9 0.25
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.5 0.52 0.55 roughness 0.9 }
      geometry Box { size 0.5 0.5 0.5 }
    }
  ]
  boundingObject Box { size 0.5 0.5 0.5 }
}
Solid {
  name "obstacle_2"
  translation 3.9 1.9 0.25
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.5 0.52 0.55 roughness 0.9 }
      geometry Box { size 0.5 0.5 0.5 }
    }
  ]
  boundingObject Box { size 0.5 0.5 0.5 }
}
Solid {
  name "obstacle_3"
  translation 6.8 -1.9 0.25
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.5 0.52 0.55 roughness 0.9 }
      geometry Box { size 0.5 0.5 0.5 }
    }
  ]
  boundingObject Box { size 0.5 0.5 0.5 }
}
# --- Decoy: near-red, wrong shade; scene furniture, not a truth target ---------------
Solid {
  name "decoy_box"
  translation 2.2 1.6 0.15
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.72 0.12 0.08 metalness 0 roughness 0.7 }
      geometry Box { size 0.4 0.4 0.3 }
    }
  ]
  boundingObject Box { size 0.4 0.4 0.3 }
}
# --- Target: one red block on a plinth, in one of the two rooms ----------------------
Solid {
  name "target_plinth"
  translation 8.8 -1.6 0.375
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.45 0.4 0.35 roughness 0.8 }
      geometry Box { size 0.6 0.6 0.75 }
    }
  ]
  boundingObject Box { size 0.6 0.6 0.75 }
}
Solid {
  name "target_block"
  translation 8.8 -1.6 0.9
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.85 0.05 0.05 metalness 0 roughness 0.6 }
      geometry Box { size 0.3 0.3 0.3 }
    }
  ]
  boundingObject Box { size 0.3 0.3 0.3 }
}
Iris {
  translation -1 0 0.09
  supervisor TRUE
  controller "compat_vehicle_controller"
  controllerArgs [
    "--sitl-address"
    "127.0.0.1"
    "--sitl-port"
    "9002"
    "--controller-port"
    "9010"
    "--motors"
    "m1_motor, m2_motor, m3_motor, m4_motor"
    "--camera-left"
    "camera left"
    "--camera-right"
    "camera right"
    "--camera-period-ms"
    "100"
    "--accelerometer"
    "accelerometer"
    "--gyro"
    "gyro"
    "--inertial-unit"
    "inertial unit"
    "--gps"
    "gps"
    "--imu-period-ms"
    "2"
  ]
  customData "{\"group\": \"first_indoor\", \"layout\": \"first-indoor\", \"mission\": \"search_inspect_return\", \"world_zero\": \"floor level, ENU\"}"
}
