# Indoor doorway Guided speeds for the control-layer proof.
# Default WPNAV_SPEED (~500 cm/s) tip-strikes / clips frames on return.
WPNAV_SPEED      80
WPNAV_SPEED_UP   80
WPNAV_SPEED_DN   60
WPNAV_ACCEL      40
WPNAV_ACCEL_Z    60
# Soften horizontal accel after large yaw so align/return does not tip-strike.
PSC_ACCEL_XY     80
